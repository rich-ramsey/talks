@article{wagenmakers2007,
  title = {An {{EZ-diffusion}} Model for Response Time and Accuracy},
  author = {Wagenmakers, Eric-Jan and Van Der Maas, Han L. J. and Grasman, Raoul P. P. P.},
  date = {2007-02-01},
  journaltitle = {Psychonomic Bulletin \& Review},
